{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.studentutilityhub.in"
        }
      ],
      "destination": "https://studentutilityhub.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "student-utility-hub-2ss3.vercel.app"
        }
      ],
      "destination": "https://studentutilityhub.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
